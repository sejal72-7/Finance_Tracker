# Copy this file to db.properties (same folder) and set your MySQL password.
# Values may also be overridden via environment variables (DB_URL, DB_USERNAME, DB_PASSWORD)
# or JVM system properties (-Ddb.url=..., -Ddb.username=..., -Ddb.password=...).

db.url=jdbc:mysql://localhost:3306/finance_tracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=YOUR_MYSQL_PASSWORD
db.pool.maxSize=10
